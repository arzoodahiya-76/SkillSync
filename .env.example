# ============================================================
# SkillSync Environment Configuration Template
# Copy this file to .env and supply your credentials.
# Do NOT commit .env to version control.
# ============================================================

# Primary AI Provider (gemini | openai)
AI_PROVIDER=gemini

# Google Gemini API Settings (Primary)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Settings (Optional)
# Get your key at: https://platform.openai.com/
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Application Settings
SECRET_KEY=skillsync-development-secret-key
PORT=5000
FLASK_DEBUG=True

# Integrations & Database (Optional)
DATABASE_URL=sqlite:///skillsync.db
GITHUB_TOKEN=
